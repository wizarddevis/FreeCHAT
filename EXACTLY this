.github/workflows/build-apk.yml
name:Build APK
on:[push]
jobs:
  build:
     runs-on:ubuntu-latest
        steps:
            -uses:actions/checkout@v4
            -name:Setup Python
            uses:actions/setup-python@v5
            with:
               python-version:'3.10'
           -name:Install Buildozer
            run: |
                pip install buildozer cython==0.29.36
                sudo apt-get update
                sudo apt-get update
                sudro apt-get install -y openjdk-17-jdk zip unzip liblt-dev
           -name:Build
           run: |
              yes | buildozer init ||true
              sed - 's/title=My Application/title= FreeChat/' buildozer.spec
              buildozer android debug
           -name:Save APK
            uses: actions/upload-artifact@v4
            with:
              name:FreeChat
               path:bin/*.apk
